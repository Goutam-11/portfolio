---
const { project } = Astro.props;
---

<article class="min-w-0 border-t border-line">
  <button type="button" class="project-open group block w-full cursor-pointer bg-transparent pt-3 text-left" data-project={project.id} aria-label={`Open ${project.name} case study`}>
    <span class="relative block aspect-[1.97] overflow-hidden bg-[#eeece5]">
      <img src={project.image} alt={project.caption} width="1400" height="710" loading="lazy" decoding="async" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.025] group-focus-visible:scale-[1.025]" />
      {project.imageKind !== 'screenshot' && <span class="absolute right-2 bottom-2 rounded bg-paper/95 px-2 py-1 text-[9px] font-semibold text-muted">{project.imageKind === 'concept' ? 'Concept illustration' : 'Screenshot to be added'}</span>}
    </span>
    <span class="mt-4 flex items-center justify-between gap-3 text-[10px] font-bold tracking-[.1em] text-accent"><span>{project.category}</span>{project.status && <span class="text-muted">{project.status}</span>}</span>
    <span class="mt-2 flex items-start justify-between gap-3"><strong class="text-[clamp(22px,2vw,30px)] leading-tight font-semibold tracking-[-.04em]">{project.name}</strong><span class="text-xl text-accent" aria-hidden="true">↗</span></span>
    <span class="mt-3 block text-[13px] leading-relaxed text-muted">{project.summary}</span>
    {project.stack.length > 0 && <span class="mt-4 block text-[11px] leading-relaxed text-muted">{project.stack.slice(0, 3).join(' · ')}</span>}
  </button>
</article>
