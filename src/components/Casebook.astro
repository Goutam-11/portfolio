<dialog class="casebook m-auto h-dvh max-h-dvh w-screen max-w-none overflow-visible border-0 bg-transparent p-0 text-ink backdrop:bg-[#171714aa]" id="casebook" aria-labelledby="book-dialog-title">
  <div class="book-stage relative grid h-full grid-rows-[1fr_auto] place-items-center px-6 pt-12 pb-7 max-sm:px-3 max-sm:pt-14 max-sm:pb-5">
    <span class="book-mark absolute top-6 left-7 text-[9px] font-bold tracking-[.15em] text-white/75 max-sm:top-5 max-sm:left-4"><span>FIELD NOTES</span> <i aria-hidden="true">/</i> <span>PROJECT <b id="book-index">01</b></span><span class="sr-only" id="book-dialog-title">Project case study</span></span>
    <button class="book-close absolute top-5 right-7 z-20 flex cursor-pointer items-center gap-3 border-0 bg-transparent px-2 py-2 text-[10px] font-semibold tracking-[.12em] text-white max-sm:top-3 max-sm:right-3" type="button" aria-label="Close case study">CLOSE <span aria-hidden="true">×</span></button>
    <div class="book-content grid h-full min-h-0 w-full place-items-center" id="book-content"></div>
    <div class="book-controls flex w-full max-w-[1120px] items-center justify-between gap-4 px-2 pt-5 text-white">
      <button class="book-control cursor-pointer border-0 bg-transparent py-2 text-left text-[10px] font-semibold tracking-[.1em] disabled:cursor-default disabled:opacity-35" id="book-prev" type="button" aria-label="Turn to previous spread">← PREVIOUS</button>
      <div class="book-progress flex items-center gap-3 text-[9px] tabular-nums text-white/75"><span id="book-page-label">01</span><span class="book-track relative h-px w-[90px] bg-white/30 max-sm:w-10"><i id="book-progress-fill" class="absolute inset-y-0 left-0 w-0 bg-white transition-[width] duration-300"></i></span><span id="book-page-total">03</span></div>
      <button class="book-sound cursor-pointer border-0 bg-transparent py-2 text-[9px] font-semibold tracking-[.1em] text-white/80 hover:text-white" id="book-sound" type="button" aria-label="Mute page-turn sound" aria-pressed="true">SOUND ON</button>
      <button class="book-control cursor-pointer border-0 bg-transparent py-2 text-right text-[10px] font-semibold tracking-[.1em] disabled:cursor-default disabled:opacity-35" id="book-next" type="button" aria-label="Turn to next spread">NEXT →</button>
    </div>
  </div>
</dialog>
