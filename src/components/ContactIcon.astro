---
const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'home' && <><path d="m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-9Z" /><path d="M9 21v-8h6v8" /></>}
  {name === 'email' && <><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'call' && <path d="M8.5 3H5a2 2 0 0 0-2 2c0 8.8 7.2 16 16 16a2 2 0 0 0 2-2v-3.5l-5-2-2 2a12 12 0 0 1-5.5-5.5l2-2-2-5Z" />}
  {name === 'whatsapp' && <><path d="M20.5 11.5a9 9 0 0 1-13 8L3 21l1.5-4.5a9 9 0 1 1 16-5Z" /><path d="M9 7.5 7.8 9a8.5 8.5 0 0 0 7.2 7.2l1.5-1.2-2.4-1.7-1.1.8a6.5 6.5 0 0 1-3.1-3.1l.8-1.1L9 7.5Z" /></>}
  {name === 'github' && <><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.8A5.3 5.3 0 0 0 19 5a4.9 4.9 0 0 0-.1-3.7s-1.2-.4-3.9 1.4a13.5 13.5 0 0 0-7 0C5.3.9 4.1 1.3 4.1 1.3A4.9 4.9 0 0 0 4 5a5.3 5.3 0 0 0-1.4 3.7c0 5.3 3.2 6.5 6.2 6.8a3.4 3.4 0 0 0-.8 2.6V22" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="7.5" cy="8" r=".75" fill="currentColor" stroke="none" /><path d="M7.5 11v6m4-6v6m0-3.5a2.5 2.5 0 0 1 5 0V17" /></>}
  {name === 'projects' && <><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></>}
  {name === 'power' && <><path d="M12 3v9m-5.5-7a8 8 0 1 0 11 0" /></>}
</svg>
